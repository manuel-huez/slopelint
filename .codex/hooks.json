{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/stop_format_and_check.py\"",
            "statusMessage": "Autofixing, formatting, and running full code checks",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
